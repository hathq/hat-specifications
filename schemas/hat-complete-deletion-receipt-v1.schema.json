{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/complete-deletion-receipt/v1",
  "title": "Subject-neutral complete local deletion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deletion_id", "policy_digest_sha256", "deletion_request_digest_sha256", "through_revision", "completed_at_epoch_s", "stores"],
  "properties": {
    "schema": { "const": "hathq://hat/complete-deletion-receipt/v1" },
    "deletion_id": { "$ref": "#/$defs/stableToken" },
    "policy_digest_sha256": { "$ref": "#/$defs/digest" },
    "deletion_request_digest_sha256": { "$ref": "#/$defs/digest" },
    "through_revision": { "type": "integer", "minimum": 0 },
    "completed_at_epoch_s": { "type": "integer", "minimum": 0 },
    "stores": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/storeReceipt" } }
  },
  "$defs": {
    "stableToken": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "storeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "store_revision", "purge_digest_sha256"],
      "properties": {
        "store_id": { "$ref": "#/$defs/stableToken" },
        "store_revision": { "type": "integer", "minimum": 1 },
        "purge_digest_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
