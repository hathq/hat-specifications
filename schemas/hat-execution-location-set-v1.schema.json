{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/execution-location-set/v1",
  "title": "Bounded HAT execution location set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "package_digest_sha256", "revision", "issued_at_epoch_s", "expires_at_epoch_s", "locations"],
  "properties": {
    "schema": {"const": "hathq://hat/execution-location-set/v1"},
    "package_id": {"type": "string", "pattern": "^hat/[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "package_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "issued_at_epoch_s": {"type": "integer", "minimum": 1},
    "expires_at_epoch_s": {"type": "integer", "minimum": 1},
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "hat-execution-location-v1.schema.json"}
    }
  }
}
