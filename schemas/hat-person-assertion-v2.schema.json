{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/person-assertion/v2",
  "title": "Evidence-linked person assertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assertion_id", "revision", "scope_ref", "subject_id", "coordinate", "producer_id", "confirmation_authority_id", "knowledge_state", "projection_digest_sha256", "evidence_refs", "recorded_at_epoch_s", "observed_at_epoch_s", "valid_from_epoch_s", "valid_until_epoch_s", "source_issued_at_epoch_s", "supersedes_assertion_id", "superseded_by_assertion_id", "conflicting_assertion_ids"],
  "properties": {
    "schema": { "const": "hathq://hat/person-assertion/v2" },
    "assertion_id": { "$ref": "#/$defs/stableToken" },
    "revision": { "type": "integer", "minimum": 1 },
    "scope_ref": { "$ref": "#/$defs/stableToken" },
    "subject_id": { "$ref": "#/$defs/stableToken" },
    "coordinate": { "$ref": "hat-information-coordinate-v1.schema.json" },
    "producer_id": { "$ref": "#/$defs/stableToken" },
    "confirmation_authority_id": { "oneOf": [{ "$ref": "#/$defs/stableToken" }, { "type": "null" }] },
    "knowledge_state": { "enum": ["observed", "proposed", "confirmed", "conflicted", "stale", "unavailable", "withdrawn", "superseded"] },
    "projection_digest_sha256": { "$ref": "#/$defs/digest" },
    "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/evidenceReference" } },
    "recorded_at_epoch_s": { "type": "integer", "minimum": 1 },
    "observed_at_epoch_s": { "type": ["integer", "null"], "minimum": 0 },
    "valid_from_epoch_s": { "type": ["integer", "null"], "minimum": 0 },
    "valid_until_epoch_s": { "type": ["integer", "null"], "minimum": 0 },
    "source_issued_at_epoch_s": { "type": ["integer", "null"], "minimum": 0 },
    "supersedes_assertion_id": { "oneOf": [{ "$ref": "#/$defs/stableToken" }, { "type": "null" }] },
    "superseded_by_assertion_id": { "oneOf": [{ "$ref": "#/$defs/stableToken" }, { "type": "null" }] },
    "conflicting_assertion_ids": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/stableToken" } }
  },
  "$defs": {
    "stableToken": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "reference", "digest_sha256"],
      "properties": {
        "owner_id": { "$ref": "#/$defs/stableToken" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "digest_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
