{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/control-grant/v1",
  "title": "Single-user represented-subject control grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grant_id", "revision", "operator_subject_id", "represented_subject_id", "position_id", "position_revision", "capacity_term_id", "action_scope_ids", "valid_from_epoch_s", "valid_until_epoch_s", "state", "revoked_at_epoch_s", "decision", "evidence_refs"],
  "properties": {
    "schema": { "const": "hathq://hat/control-grant/v1" },
    "grant_id": { "$ref": "#/$defs/stableToken" },
    "revision": { "type": "integer", "minimum": 1 },
    "operator_subject_id": { "$ref": "#/$defs/stableToken" },
    "represented_subject_id": { "$ref": "#/$defs/stableToken" },
    "position_id": { "$ref": "#/$defs/stableToken" },
    "position_revision": { "type": "integer", "minimum": 1 },
    "capacity_term_id": { "type": "string", "pattern": "^hathq://vocabulary/capacity/[a-z0-9][a-z0-9-]*/v[1-9][0-9]*$" },
    "action_scope_ids": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^hathq://vocabulary/action/[a-z0-9][a-z0-9-]*/v[1-9][0-9]*$" } },
    "valid_from_epoch_s": { "type": "integer", "minimum": 0 },
    "valid_until_epoch_s": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["active", "revoked"] },
    "revoked_at_epoch_s": { "type": ["integer", "null"], "minimum": 0 },
    "decision": { "$ref": "#/$defs/decision" },
    "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/evidenceReference" } }
  },
  "$defs": {
    "stableToken": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decided_by_subject_id", "decision_revision", "decision_digest_sha256"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/stableToken" },
        "decided_by_subject_id": { "$ref": "#/$defs/stableToken" },
        "decision_revision": { "type": "integer", "minimum": 1 },
        "decision_digest_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "reference", "digest_sha256"],
      "properties": {
        "owner_id": { "$ref": "#/$defs/stableToken" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "digest_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
