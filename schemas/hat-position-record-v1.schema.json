{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/position-record/v1",
  "title": "Revisioned HAT position record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "position_id", "revision", "previous_revision", "change", "holder_subject_id", "context_subject_id", "position_term_id", "valid_from_epoch_s", "valid_until_epoch_s", "evidence_refs"],
  "properties": {
    "schema": { "const": "hathq://hat/position-record/v1" },
    "position_id": { "$ref": "#/$defs/stableToken" },
    "revision": { "type": "integer", "minimum": 1 },
    "previous_revision": { "type": ["integer", "null"], "minimum": 1 },
    "change": { "enum": ["attach", "close", "supersede"] },
    "holder_subject_id": { "$ref": "#/$defs/stableToken" },
    "context_subject_id": { "$ref": "#/$defs/stableToken" },
    "position_term_id": { "type": "string", "pattern": "^hathq://vocabulary/position/[a-z0-9][a-z0-9-]*/v[1-9][0-9]*$" },
    "valid_from_epoch_s": { "type": "integer", "minimum": 0 },
    "valid_until_epoch_s": { "type": ["integer", "null"], "minimum": 0 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/evidenceReference" }
    }
  },
  "$defs": {
    "stableToken": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "reference", "digest_sha256"],
      "properties": {
        "owner_id": { "$ref": "#/$defs/stableToken" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "digest_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
