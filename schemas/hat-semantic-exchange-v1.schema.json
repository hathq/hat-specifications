{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/semantic-exchange/v1",
  "title": "Cross-owner semantic result proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "exchange_id", "sender", "receiver", "clause", "terms", "frame_digest_sha256", "output_schema_digest_sha256", "source_revision", "evidence", "information_classification", "purpose", "retention", "issued_at_epoch_s", "expires_at_epoch_s", "nonce", "content_digest_sha256"],
  "properties": {
    "schema": { "const": "hathq://hat/semantic-exchange/v1" },
    "exchange_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "sender": { "$ref": "hathq://hat/semantic-clause/v1#/$defs/stableRef" }, "receiver": { "$ref": "hathq://hat/semantic-clause/v1#/$defs/stableRef" },
    "clause": { "$ref": "hathq://hat/semantic-clause/v1" },
    "terms": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "hathq://hat/semantic-catalog/v1#/$defs/termRef" } },
    "frame_digest_sha256": { "$ref": "#/$defs/digest" }, "output_schema_digest_sha256": { "$ref": "#/$defs/digest" },
    "source_revision": { "type": "integer", "minimum": 1 },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "hathq://hat/semantic-clause/v1#/$defs/stableRef" } },
    "information_classification": { "enum": ["public", "internal", "internal-confidential", "restricted-sensitive"] },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
    "retention": { "$ref": "hathq://hat/semantic-clause/v1#/$defs/stableRef" },
    "issued_at_epoch_s": { "type": "integer", "minimum": 1 }, "expires_at_epoch_s": { "type": "integer", "minimum": 1 },
    "nonce": { "type": "string", "minLength": 1, "maxLength": 512 }, "content_digest_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
