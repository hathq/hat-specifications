{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/automation-policy/v1",
  "title": "Owner-approved gradual automation policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "revision", "role_instance_id", "operation_id", "scope_refs", "condition_refs", "mode", "valid_from_epoch_s", "valid_until_epoch_s", "decision"],
  "properties": {
    "schema": { "const": "hathq://hat/automation-policy/v1" },
    "policy_id": { "$ref": "#/$defs/token" },
    "revision": { "type": "integer", "minimum": 1 },
    "role_instance_id": { "$ref": "#/$defs/token" },
    "operation_id": { "type": "string", "pattern": "^hathq://[^?#@]+$", "maxLength": 512 },
    "scope_refs": { "$ref": "#/$defs/requiredReferences" },
    "condition_refs": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
    "mode": { "enum": ["observe", "propose", "conditional", "delegated"] },
    "valid_from_epoch_s": { "type": "integer", "minimum": 0 },
    "valid_until_epoch_s": { "type": "integer", "minimum": 1 },
    "decision": { "$ref": "#/$defs/decision" }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference": { "type": "object", "additionalProperties": false, "required": ["schema", "id", "revision", "digest_sha256"], "properties": { "schema": { "type": "string", "pattern": "^hathq://[^?#@]+$", "maxLength": 512 }, "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "revision": { "type": "integer", "minimum": 1 }, "digest_sha256": { "$ref": "#/$defs/digest" } } },
    "requiredReferences": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["decision_id", "decided_by_subject_id", "decision_revision", "decision_digest_sha256"], "properties": { "decision_id": { "$ref": "#/$defs/token" }, "decided_by_subject_id": { "$ref": "#/$defs/token" }, "decision_revision": { "type": "integer", "minimum": 1 }, "decision_digest_sha256": { "$ref": "#/$defs/digest" } } }
  }
}
