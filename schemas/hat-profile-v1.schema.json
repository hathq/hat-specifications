{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/profile/v1",
  "title": "HAT fitting profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "granted_capabilities", "allowed_resources", "decision_authorities", "maximum_input_classification"],
  "properties": {
    "schema": { "const": "hathq://hat/profile/v1" },
    "id": { "type": "string", "pattern": "^profile/[a-z0-9](?:[a-z0-9-]{0,94}[a-z0-9])?$" },
    "granted_capabilities": { "$ref": "#/$defs/stableTokens" },
    "allowed_resources": { "$ref": "#/$defs/stableTokens" },
    "decision_authorities": { "$ref": "#/$defs/stableTokens" },
    "maximum_input_classification": {
      "enum": ["public", "internal", "internal-confidential", "restricted-sensitive"]
    }
  },
  "$defs": {
    "stableToken": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,94}[a-z0-9])?$"
    },
    "stableTokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableToken" }
    }
  }
}
