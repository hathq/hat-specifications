{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "hathq://hat/task/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "task_id", "revision", "goal", "commitment", "derived_by_hat", "derived_from_requirement", "derivation_rule", "observation_refs", "operation", "capability", "scope_refs", "dependency_refs", "constraint_refs", "state", "delegation", "verified_by"],
  "properties": {
    "schema": { "const": "hathq://hat/task/v2" }, "task_id": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/token" }, "revision": { "type": "integer", "minimum": 1 },
    "goal": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" }, "commitment": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" }, "derived_by_hat": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" },
    "derived_from_requirement": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" }, "derivation_rule": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" },
    "observation_refs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" } },
    "operation": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/term" }, "capability": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/term" },
    "scope_refs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" } },
    "dependency_refs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" } }, "constraint_refs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" } },
    "state": { "enum": ["candidate", "awaiting-decision", "ready", "blocked", "executing", "awaiting-verification", "completed", "exception", "cancelled"] },
    "delegation": { "oneOf": [{ "type": "null" }, { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" }] }, "verified_by": { "oneOf": [{ "type": "null" }, { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" }] }
  }
}
