{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/representative-role-instance/v1",
  "title": "Owner-bound representative role instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "instance_id", "archetype_id", "parent_instance_id", "owner_subject_id", "display_name", "description", "scope_refs", "context_refs", "hat_binding_refs", "automation_policy_ref", "revision", "state"],
  "properties": {
    "schema": { "const": "hathq://hat/representative-role-instance/v1" },
    "instance_id": { "$ref": "#/$defs/token" },
    "archetype_id": { "$ref": "#/$defs/token" },
    "parent_instance_id": { "oneOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
    "owner_subject_id": { "$ref": "#/$defs/token" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 512 },
    "scope_refs": { "$ref": "#/$defs/references" },
    "context_refs": { "$ref": "#/$defs/optionalReferences" },
    "hat_binding_refs": { "$ref": "#/$defs/optionalReferences" },
    "automation_policy_ref": { "oneOf": [{ "$ref": "#/$defs/reference" }, { "type": "null" }] },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["active", "suspended", "closed"] }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference": { "type": "object", "additionalProperties": false, "required": ["schema", "id", "revision", "digest_sha256"], "properties": { "schema": { "type": "string", "pattern": "^hathq://[^?#@]+$", "maxLength": 512 }, "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "revision": { "type": "integer", "minimum": 1 }, "digest_sha256": { "$ref": "#/$defs/digest" } } },
    "references": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
    "optionalReferences": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } }
  }
}
