{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/communication-capability/v1",
  "title": "Exact protocol-speaking capability without endpoint or authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "protocol", "role", "direction", "operation_ids"],
  "properties": {
    "schema": { "const": "hathq://hat/communication-capability/v1" },
    "id": { "$ref": "#/$defs/token" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "role": { "enum": ["client", "server", "peer"] },
    "direction": { "enum": ["send", "receive", "bidirectional"] },
    "operation_ids": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/hatUri" }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,94}[a-z0-9])?$" },
    "hatUri": { "type": "string", "pattern": "^hathq://[a-z0-9][a-z0-9./-]*/v[1-9][0-9]*$" },
    "absoluteProtocolRef": {
      "type": "string", "minLength": 4, "maxLength": 384,
      "pattern": "^[a-z][a-z0-9+.-]{1,31}:[^\\s@?#]+$"
    },
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_id", "protocol_id", "version", "specification_ref"],
      "properties": {
        "owner_id": { "$ref": "#/$defs/token" },
        "protocol_id": { "$ref": "#/$defs/absoluteProtocolRef" },
        "version": { "type": "integer", "minimum": 1 },
        "specification_ref": { "$ref": "#/$defs/absoluteProtocolRef" }
      }
    }
  }
}
