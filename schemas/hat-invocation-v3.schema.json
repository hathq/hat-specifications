{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/invocation/v3",
  "title": "Context-partitioned HAT invocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "invocation_id", "binding", "context_partition", "operation_id", "expected_projection_revision", "idempotency_key", "input", "effective_grant", "placement"],
  "properties": {
    "schema": { "const": "hathq://hat/invocation/v3" },
    "invocation_id": { "$ref": "#/$defs/token" },
    "binding": { "$ref": "hathq://hat/binding/v1" },
    "context_partition": { "$ref": "#/$defs/contextPartition" },
    "operation_id": { "$ref": "#/$defs/schemaId" },
    "expected_projection_revision": { "type": "integer", "minimum": 0 },
    "idempotency_key": { "$ref": "#/$defs/token" },
    "input": { "$ref": "#/$defs/reference" },
    "effective_grant": { "$ref": "#/$defs/reference" },
    "placement": { "$ref": "#/$defs/reference" }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,94}[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "schemaId": { "type": "string", "pattern": "^hathq://[a-z0-9./-]+/v[1-9][0-9]*$" },
    "contextPartition": {
      "type": "object", "additionalProperties": false,
      "required": ["context_partition_id", "revision", "policy_digest_sha256"],
      "properties": {
        "context_partition_id": { "$ref": "#/$defs/token" },
        "revision": { "type": "integer", "minimum": 0 },
        "policy_digest_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_id", "reference", "schema_id", "digest_sha256"],
      "properties": {
        "owner_id": { "$ref": "#/$defs/token" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "schema_id": { "$ref": "#/$defs/schemaId" },
        "digest_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
