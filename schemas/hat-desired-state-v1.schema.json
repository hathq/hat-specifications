{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "hathq://hat/desired-state/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "desired_state_id", "revision", "subject", "requirements", "valid_from_epoch_s", "valid_until_epoch_s", "evidence_refs"],
  "properties": {
    "schema": { "const": "hathq://hat/desired-state/v1" }, "desired_state_id": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/token" },
    "revision": { "type": "integer", "minimum": 1 }, "subject": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" },
    "requirements": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" } },
    "valid_from_epoch_s": { "type": "integer", "minimum": 1 }, "valid_until_epoch_s": { "type": ["integer", "null"], "minimum": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/evidence" } }
  }
}
