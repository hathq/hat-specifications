{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/semantic-contribution/v1",
  "title": "Catalog-bound semantic contribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer_hat", "canonical_source", "source_revision", "content_digest_sha256", "catalogs", "sources", "entities", "relations", "events", "assertions", "evidence", "bindings"],
  "properties": {
    "schema": { "const": "hathq://hat/semantic-contribution/v1" },
    "producer_hat": { "$ref": "#/$defs/stableRef" },
    "canonical_source": { "$ref": "#/$defs/stableRef" },
    "source_revision": { "type": "integer", "minimum": 0 },
    "content_digest_sha256": { "$ref": "#/$defs/digest" },
    "catalogs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "hathq://hat/semantic-catalog/v1#/$defs/catalogRef" } },
    "sources": { "type": "array", "maxItems": 4096, "items": { "type": "object" } },
    "entities": { "type": "array", "maxItems": 4096, "items": { "type": "object" } },
    "relations": { "type": "array", "maxItems": 8192, "items": { "type": "object" } },
    "events": { "type": "array", "maxItems": 8192, "items": { "type": "object" } },
    "assertions": { "type": "array", "maxItems": 8192, "items": { "type": "object" } },
    "evidence": { "type": "array", "maxItems": 8192, "items": { "type": "object" } },
    "bindings": { "type": "array", "maxItems": 256, "items": { "type": "object" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stableRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "revision", "digest_sha256"],
      "properties": {
        "schema": { "type": "string", "minLength": 1, "maxLength": 512 },
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": "integer", "minimum": 0 },
        "digest_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
