{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/placement-selection/v2",
  "title": "Owner-approved context partition HAT placement selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "selection_id", "context_partition_id", "package_id", "package_digest_sha256", "location_id", "location_digest_sha256", "route_policy_digest_sha256", "permitted_classifications", "approved_failover_location_digests", "revision", "selected_at_epoch_s"],
  "properties": {
    "schema": {"const": "hathq://hat/placement-selection/v2"},
    "selection_id": {"$ref": "#/$defs/token"},
    "context_partition_id": {"$ref": "#/$defs/token"},
    "package_id": {"type": "string", "pattern": "^hat/[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "package_digest_sha256": {"$ref": "#/$defs/digest"},
    "location_id": {"$ref": "#/$defs/token"},
    "location_digest_sha256": {"$ref": "#/$defs/digest"},
    "route_policy_digest_sha256": {"$ref": "#/$defs/digest"},
    "permitted_classifications": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["public", "internal", "internal-confidential", "restricted-sensitive"]}},
    "approved_failover_location_digests": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "revision": {"type": "integer", "minimum": 1},
    "selected_at_epoch_s": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,94}[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
