{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/semantic-catalog/v1",
  "title": "Immutable semantic vocabulary catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "owner_repository_id", "foundation", "dependencies", "incompatibilities", "terms", "lexicalizations", "frames"],
  "properties": {
    "schema": { "const": "hathq://hat/semantic-catalog/v1" },
    "identity": { "$ref": "#/$defs/catalogRef" },
    "owner_repository_id": { "$ref": "#/$defs/token" },
    "foundation": { "type": "boolean" },
    "dependencies": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/catalogRef" } },
    "incompatibilities": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/catalogRef" } },
    "terms": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/termDefinition" } },
    "lexicalizations": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/lexicalization" } },
    "frames": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/frame" } }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kind": { "enum": ["concept", "entity-type", "relation", "predicate", "property", "event-type", "state-type", "action", "reason", "unit", "protocol-field"] },
    "role": { "enum": ["actor", "subject", "object", "value", "source", "destination", "instrument", "time", "place", "evidence", "output"] },
    "catalogRef": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_id", "version", "digest_sha256"],
      "properties": { "catalog_id": { "$ref": "#/$defs/token" }, "version": { "type": "integer", "minimum": 1 }, "digest_sha256": { "$ref": "#/$defs/digest" } }
    },
    "termRef": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_id", "catalog_digest_sha256", "term_id", "version", "definition_digest_sha256", "kind"],
      "properties": { "catalog_id": { "$ref": "#/$defs/token" }, "catalog_digest_sha256": { "$ref": "#/$defs/digest" }, "term_id": { "$ref": "#/$defs/token" }, "version": { "type": "integer", "minimum": 1 }, "definition_digest_sha256": { "$ref": "#/$defs/digest" }, "kind": { "$ref": "#/$defs/kind" } }
    },
    "termSet": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/termRef" } },
    "termDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "semantic_icon", "dependencies", "is_a", "domain", "range"],
      "properties": { "reference": { "$ref": "#/$defs/termRef" }, "wire_schema": { "$ref": "#/$defs/token" }, "semantic_icon": { "enum": ["generic", "entity", "identity", "person", "people", "organization", "place", "jurisdiction", "language", "biology", "health", "time", "event", "state", "action", "reason", "relation", "evidence", "source", "resource", "asset", "money", "accounting", "work", "repository", "software", "communication", "service", "credential", "model", "hat", "layer", "namespace", "directory", "file", "decision", "contract"] }, "dependencies": { "$ref": "#/$defs/termSet" }, "is_a": { "$ref": "#/$defs/termSet" }, "domain": { "$ref": "#/$defs/termSet" }, "range": { "$ref": "#/$defs/termSet" } }
    },
    "lexicalization": {
      "type": "object", "additionalProperties": false,
      "required": ["term", "locale", "preferred", "search_aliases"],
      "properties": { "term": { "$ref": "#/$defs/termRef" }, "locale": { "type": "string", "pattern": "^[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8})*$" }, "preferred": { "type": "string", "minLength": 1, "maxLength": 160 }, "search_aliases": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } } }
    },
    "roleSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "required", "accepted_kinds"],
      "properties": { "role": { "$ref": "#/$defs/role" }, "required": { "type": "boolean" }, "accepted_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/kind" } } }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_id", "definition_digest_sha256", "predicate", "roles"],
      "properties": { "frame_id": { "$ref": "#/$defs/token" }, "definition_digest_sha256": { "$ref": "#/$defs/digest" }, "predicate": { "$ref": "#/$defs/termRef" }, "roles": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/roleSpec" } } }
    }
  }
}
