{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/operational-definitions/v1",
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "revision", "digest_sha256"],
      "properties": {
        "schema": { "type": "string", "pattern": "^hathq://.+/v[1-9][0-9]*$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revision": { "type": "integer", "minimum": 1 },
        "digest_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_id", "reference", "digest_sha256"],
      "properties": {
        "owner_id": { "$ref": "#/$defs/token" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "digest_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "decided_by_subject_id", "decision_revision", "decision_digest_sha256"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/token" },
        "decided_by_subject_id": { "$ref": "#/$defs/token" },
        "decision_revision": { "type": "integer", "minimum": 1 },
        "decision_digest_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "term": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_id", "catalog_digest_sha256", "term_id", "version", "definition_digest_sha256", "kind"],
      "properties": {
        "catalog_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "catalog_digest_sha256": { "$ref": "#/$defs/digest" },
        "term_id": { "type": "string", "pattern": "^hathq://.+/v[1-9][0-9]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "definition_digest_sha256": { "$ref": "#/$defs/digest" },
        "kind": { "enum": ["concept", "entity-type", "relation", "predicate", "property", "event-type", "state-type", "action", "reason", "unit", "protocol-field"] }
      }
    }
  }
}
