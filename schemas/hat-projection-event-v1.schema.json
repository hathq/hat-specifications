{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/projection-event/v1",
  "title": "Vocabulary-bound HAT projection event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "event_type", "occurred_time", "observed_at_epoch_ms", "correlation_id", "causation_id", "invocation_id", "context_partition_id", "operation_id", "previous_revision", "next_revision", "evidence_refs"],
  "properties": {
    "schema": { "const": "hathq://hat/projection-event/v1" },
    "event_id": { "$ref": "#/$defs/token" },
    "event_type": { "const": "core.event.action.completed" },
    "occurred_time": { "$ref": "#/$defs/interval" },
    "observed_at_epoch_ms": { "type": "integer", "minimum": 0 },
    "correlation_id": { "$ref": "#/$defs/token" },
    "causation_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reference" }] },
    "invocation_id": { "$ref": "#/$defs/token" },
    "context_partition_id": { "$ref": "#/$defs/token" },
    "operation_id": { "type": "string", "pattern": "^hathq://[a-z0-9./-]+/v[1-9][0-9]*$" },
    "previous_revision": { "type": "integer", "minimum": 0 },
    "next_revision": { "type": "integer", "minimum": 1 },
    "evidence_refs": { "type": "array", "maxItems": 256, "items": { "type": "object" } }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 96 },
    "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_epoch_ms", "end_epoch_ms"],
      "properties": {
        "start_epoch_ms": { "type": "integer", "minimum": 0 },
        "end_epoch_ms": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] }
      }
    }
  }
}
