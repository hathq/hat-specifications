{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/inference-action/v1",
  "title": "User-inspectable inference action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "action_id", "revision", "routine_id", "title_key", "producer_repository_id", "invocation_id", "route_id", "operation_id", "role_id", "state", "trigger", "input_snapshot", "procedure", "decision", "proposed_effects", "delegation", "output", "reason_id", "created_at_epoch_s", "updated_at_epoch_s"],
  "properties": {
    "schema": { "const": "hathq://hat/inference-action/v1" },
    "action_id": { "$ref": "#/$defs/token" },
    "revision": { "type": "integer", "minimum": 1 },
    "routine_id": { "$ref": "#/$defs/token" },
    "title_key": { "type": "string", "pattern": "^[a-z0-9._-]+$", "maxLength": 160 },
    "producer_repository_id": { "type": "string", "pattern": "^hat-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "invocation_id": { "$ref": "#/$defs/token" },
    "route_id": { "$ref": "#/$defs/token" },
    "operation_id": { "$ref": "#/$defs/uri" },
    "role_id": { "$ref": "#/$defs/uri" },
    "state": { "enum": ["prepared", "running", "waiting", "unresolved", "completed", "failed", "cancelled"] },
    "trigger": { "$ref": "#/$defs/trigger" },
    "input_snapshot": { "$ref": "#/$defs/snapshot" },
    "procedure": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/step" } },
    "decision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/decision" }] },
    "proposed_effects": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/effect" } },
    "delegation": { "$ref": "#/$defs/delegation" },
    "output": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reference" }] },
    "reason_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uri" }] },
    "created_at_epoch_s": { "type": "integer", "minimum": 1 },
    "updated_at_epoch_s": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,94}[a-z0-9])?$" },
    "uri": { "type": "string", "pattern": "^hathq://[a-z0-9./-]+/v[1-9][0-9]*$", "maxLength": 512 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference": { "type": "object", "additionalProperties": false, "required": ["owner_id", "reference", "schema_id", "digest_sha256"], "properties": { "owner_id": { "$ref": "#/$defs/token" }, "reference": { "type": "string", "minLength": 1, "maxLength": 512 }, "schema_id": { "$ref": "#/$defs/uri" }, "digest_sha256": { "$ref": "#/$defs/digest" } } },
    "trigger": { "type": "object", "additionalProperties": false, "required": ["kind", "source"], "properties": { "kind": { "enum": ["event", "schedule", "owner-request"] }, "source": { "$ref": "#/$defs/reference" } } },
    "input": { "type": "object", "additionalProperties": false, "required": ["field_id", "label_key", "value_kind", "canonical_value", "source", "purpose_term_id", "information_classification", "included"], "properties": { "field_id": { "$ref": "#/$defs/token" }, "label_key": { "type": "string", "pattern": "^[a-z0-9._-]+$", "maxLength": 160 }, "value_kind": { "enum": ["text", "timestamp", "reference", "count", "boolean"] }, "canonical_value": { "type": "string", "minLength": 1, "maxLength": 4096 }, "source": { "$ref": "#/$defs/reference" }, "purpose_term_id": { "$ref": "#/$defs/uri" }, "information_classification": { "enum": ["public", "internal", "internal-confidential", "restricted-sensitive"] }, "included": { "type": "boolean" } } },
    "snapshot": { "type": "object", "additionalProperties": false, "required": ["digest_sha256", "items"], "properties": { "digest_sha256": { "$ref": "#/$defs/digest" }, "items": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/input" } } } },
    "step": { "type": "object", "additionalProperties": false, "required": ["step_id", "kind", "title_key", "state"], "properties": { "step_id": { "$ref": "#/$defs/token" }, "kind": { "enum": ["observe", "normalize", "infer", "validate", "propose", "execute"] }, "title_key": { "type": "string", "pattern": "^[a-z0-9._-]+$", "maxLength": 160 }, "state": { "enum": ["upcoming", "current", "complete", "error"] } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["state", "candidate_ids", "selected_candidate_id", "evidence_field_ids", "reason_id"], "properties": { "state": { "enum": ["confirmed", "ambiguous", "unresolved"] }, "candidate_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/uri" } }, "selected_candidate_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uri" }] }, "evidence_field_ids": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }, "reason_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uri" }] } } },
    "effect": { "type": "object", "additionalProperties": false, "required": ["effect_id", "kind", "surface_id", "payload", "requires_approval"], "properties": { "effect_id": { "$ref": "#/$defs/token" }, "kind": { "enum": ["create", "link", "update"] }, "surface_id": { "$ref": "#/$defs/uri" }, "payload": { "$ref": "#/$defs/reference" }, "requires_approval": { "type": "boolean" } } },
    "delegation": { "type": "object", "additionalProperties": false, "required": ["mode", "policy"], "properties": { "mode": { "enum": ["observe", "propose", "conditional", "delegated"] }, "policy": { "$ref": "#/$defs/reference" } } }
  }
}
