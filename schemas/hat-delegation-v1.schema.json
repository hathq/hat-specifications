{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "hathq://hat/delegation/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "delegation_id", "revision", "task", "delegator", "delegate", "capability", "scope_refs", "condition_refs", "valid_from_epoch_s", "valid_until_epoch_s", "maximum_executions", "state", "decision"],
  "properties": {
    "schema": { "const": "hathq://hat/delegation/v1" }, "delegation_id": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/token" }, "revision": { "type": "integer", "minimum": 1 },
    "task": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" }, "delegator": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" }, "delegate": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" }, "capability": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/term" },
    "scope_refs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" } }, "condition_refs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/reference" } },
    "valid_from_epoch_s": { "type": "integer", "minimum": 1 }, "valid_until_epoch_s": { "type": "integer", "minimum": 1 }, "maximum_executions": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "state": { "enum": ["active", "revoked", "expired", "exhausted"] }, "decision": { "$ref": "hathq://hat/operational-definitions/v1#/$defs/decision" }
  }
}
