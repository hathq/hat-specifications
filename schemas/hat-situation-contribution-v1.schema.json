{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/situation-contribution/v1",
  "title": "Source-preserving HAT event or action contribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contribution_id", "category_term_id", "kind", "title", "status", "time", "place", "actors", "object_label", "detail_handle", "source"],
  "properties": {
    "schema": { "const": "hathq://hat/situation-contribution/v1" },
    "contribution_id": { "$ref": "#/$defs/token" },
    "category_term_id": { "type": "string", "pattern": "^hathq://vocabulary/[a-z0-9-]+/[a-z0-9-]+/v[1-9][0-9]*$" },
    "kind": { "enum": ["event", "task", "observation", "question"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["planned", "active", "waiting", "completed", "cancelled", "unresolved"] },
    "time": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/time" }] },
    "place": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/place" }] },
    "actors": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "object_label": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "detail_handle": { "$ref": "#/$defs/token" },
    "source": { "$ref": "#/$defs/source" }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,94}[a-z0-9])?$" },
    "time": { "type": "object", "additionalProperties": false, "required": ["start_at_unix_ms", "end_at_unix_ms", "time_zone"], "properties": { "start_at_unix_ms": { "type": "integer", "minimum": 0 }, "end_at_unix_ms": { "type": ["integer", "null"], "minimum": 0 }, "time_zone": { "type": "string", "minLength": 1, "maxLength": 80 } } },
    "coordinates": { "type": "object", "additionalProperties": false, "required": ["latitude", "longitude"], "properties": { "latitude": { "type": "number", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 } } },
    "place": { "type": "object", "additionalProperties": false, "required": ["label", "coordinates"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 160 }, "coordinates": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/coordinates" }] } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["repository_id", "digest_sha256", "revision"], "properties": { "repository_id": { "$ref": "#/$defs/token" }, "digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "revision": { "type": "integer", "minimum": 1 } } }
  }
}
