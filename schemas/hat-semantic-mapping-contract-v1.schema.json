{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat/semantic-mapping-contract/v1",
  "title": "External schema to Hatter vocabulary mapping contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "revision", "owner_repository_id", "external_schema", "target_catalogs", "field_mappings", "unresolved_policy"],
  "properties": {
    "schema": { "const": "hathq://hat/semantic-mapping-contract/v1" },
    "contract_id": { "$ref": "#/$defs/token" },
    "revision": { "type": "integer", "minimum": 1 },
    "owner_repository_id": { "$ref": "#/$defs/token" },
    "external_schema": { "$ref": "#/$defs/schemaRef" },
    "target_catalogs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "hathq://hat/semantic-catalog/v1#/$defs/catalogRef" }
    },
    "field_mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/fieldMapping" }
    },
    "unresolved_policy": { "enum": ["record-unresolved", "reject"] }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "schemaRef": { "type": "string", "pattern": "^hathq://[a-z0-9][a-z0-9./-]*/v[1-9][0-9]*$" },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "source_pointer", "target_term", "target_field", "required"],
      "properties": {
        "mapping_id": { "$ref": "#/$defs/token" },
        "source_pointer": { "type": "string", "minLength": 1, "maxLength": 256 },
        "target_term": { "$ref": "hathq://hat/semantic-catalog/v1#/$defs/termRef" },
        "target_field": { "$ref": "#/$defs/token" },
        "required": { "type": "boolean" }
      }
    }
  }
}
